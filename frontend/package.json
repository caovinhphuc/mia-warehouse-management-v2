{
  "name": "mia-vn-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend app extracted from main project",
  "packageManager": "npm@9.9.1",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "test:email": "jest --watchAll=false --passWithNoTests --testPathPattern=src/__tests__/email.test.js",
    "preview": "vite preview",
    "deploy:production": "npm run build && serve -s dist",
    "health-check:backend": "node ../scripts/health-check-backend.js",
    "test:telegram": "jest --watchAll=false --passWithNoTests --testPathPattern=src/__tests__/telegram.test.js",
    "test": "jest --watchAll=false --passWithNoTests",
    "lint": "eslint src/ --max-warnings=0",
    "lintfix": "eslint src/ --fix",
    "audit:security": "npm audit",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,scss,md}\" --ignore-path .gitignore",
    "analytics:realtime ": "node ../scripts/analytics-realtime.js",
    "monitor:uptime": "node ../scripts/monitor-uptime.js",
    "analyze:bundle": "node scripts/optimize-bundle.js",
    "build:stats": "npm run build && node scripts/optimize-bundle.js",
    "perf:check": "node ../scripts/performance-bundle.js"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.2",
    "@babel/eslint-parser": "^7.28.6",
    "@eslint/js": "^9.39.2",
    "@mui/material": "^7.3.7",
    "@mui/system": "^7.3.9",
    "@sentry/react": "^10.43.0",
    "antd": "^5.27.4",
    "axios": "^1.12.2",
    "dayjs": "^1.11.20",
    "lodash": "^4.17.21",
    "lucide-react": "^0.577.0",
    "moment": "^2.30.1",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.5.2",
    "react-is": "18.2.0",
    "react-redux": "^9.1.2",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "socket.io-client": "^4.8.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "babel-jest": "^29.7.0",
    "babel-plugin-import": "^1.13.8",
    "babel-plugin-lodash": "^3.3.4",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.2",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "form-data": "^4.0.5",
    "http-proxy-middleware": "^3.0.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "node-fetch": "^3.3.2",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "serve": "^14.0.0",
    "sharp": "^0.34.5",
    "source-map-explorer": "^2.5.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17"
  },
  "overrides": {

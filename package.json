  "license": "MIT",
  "packageManager": "npm@9.9.1",
  "keywords": [
    "react",
    "google-sheets",
    "google-drive",
    "automation",
    "mia-vn"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.0.2",

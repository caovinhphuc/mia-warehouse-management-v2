    "assert": "^2.1.0",
    "axios": "^1.12.2",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "express": "^5.1.0",
    "formidable": "^3.5.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.544.0",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "process": "^0.11.10",
    "react": "18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "18.2.0",
    "react-grid-layout": "^1.5.2",
    "react-is": "18.2.0",
    "react-redux": "^9.1.2",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.2.1",
    "redux": "^5.0.1",

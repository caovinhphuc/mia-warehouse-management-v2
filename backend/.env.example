# Backend env - optional
# Nếu không có file .env trong thư mục backend, server sẽ dùng .env ở root project.
# Copy file này thành .env và điền giá trị, hoặc chỉ cần dùng .env ở root.

# Port
BACKEND_PORT=3001
PORT=3001

# Google Sheets & Drive (cần key thật - xem docs/GOOGLE_SHEETS_DRIVE_SETUP.md)
# Cách 1: trỏ tới file JSON key tải từ GCP Console (IAM → Service account → Keys)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
# Cách 2: dùng env (GOOGLE_PRIVATE_KEY = nội dung trường private_key trong JSON, giữ \n)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Auth
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h
SESSION_SECRET=your_session_secret
BCRYPT_ROUNDS=10

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Service (proxy /api/ai/*)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=15000

# Optional: Telegram, Email, SSO...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SENDGRID_API_KEY=
# AI_SERVICE_URL=http://localhost:8000

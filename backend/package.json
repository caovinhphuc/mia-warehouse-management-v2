{
  "name": "one-project-backend",
  "version": "1.0.0",
  "description": "Backend API for Business Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:legacy": "NODE_OPTIONS=--openssl-legacy-provider node server.js",
    "dev": "nodemon server.js",
    "test": "jest --passWithNoTests",
    "test:ws": "node test-websocket.js",
    "test:ws:health": "node ws-health-check.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:production": "NODE_ENV=production webpack --mode production",
    "deploy:docker": "docker-compose up --build -d",
    "lint:check": "eslint . --max-warnings=0",
    "deploy:netlify": "npm run build:production && netlify deploy --prod --dir=build",
    "build": "npm run test"
  },
  "dependencies": {
    "@mui/material": "^7.3.7",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.0",
    "chart.js": "^4.5.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.6.1",
    "eslint": "^8.42.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "googleapis": "^118.0.0",
    "helmet": "^7.0.0",
    "jest": "^29.5.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.3",
    "nodemon": "^3.1.9",
    "prettier": "^2.8.8",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^2.4.1",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "supertest": "^6.3.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "babel-loader": "^10.0.0",
    "babel-plugin-import": "^1.13.8",
    "babel-plugin-lodash": "^3.3.4",
    "css-loader": "^7.1.2",
    "cssnano": "^7.1.2",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "postcss-loader": "^8.2.0",
    "prettier": "^2.8.8",
    "style-loader": "^4.0.0",
    "supertest": "^6.3.3",
    "vitest": "^4.0.17",
    "webpack-cli": "^7.0.0"
  },
  "keywords": [
    "business",
    "management",
    "api",
    "nodejs",
    "express"
  ],
  "author": "Business Management Team",
  "license": "MIT"
}

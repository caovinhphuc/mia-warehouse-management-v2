# ========================================================
# MIA WAREHOUSE MANAGEMENT V2 - Environment Variables
# ========================================================
# Copy file này thành .env và cập nhật giá trị của bạn
# ========================================================

# ======================
# APPLICATION CONFIG
# ======================
NODE_ENV=development
VITE_APP_NAME=MIA Warehouse Management
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development

# ======================
# SERVER CONFIGURATION
# ======================
PORT=3000
VITE_PORT=3000
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BACKEND_URL=http://localhost:8000
WEBSOCKET_PORT=8000

# ======================
# GOOGLE CLOUD PLATFORM
# ======================
# Google Sheets API
VITE_GOOGLE_SHEETS_API_KEY=your_google_api_key_here
VITE_GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Google OAuth 2.0
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Service Account (Backend)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./automation/config/google-credentials.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

# ======================
# FEATURE FLAGS
# ======================
VITE_USE_MOCK_DATA=false
VITE_ENABLE_GOOGLE_SHEETS=true
VITE_ENABLE_GOOGLE_DRIVE=true
VITE_ENABLE_GOOGLE_APPS_SCRIPT=true
VITE_ENABLE_AI_SERVICE=true
VITE_ENABLE_WEBSOCKET=true

# ======================
# AUTHENTICATION & SECURITY
# ======================
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_EXPIRES_IN=24h
SESSION_SECRET=your_session_secret_min_32_characters
SESSION_TIMEOUT=3600000
BCRYPT_ROUNDS=10

# SSO Configuration
VITE_ENABLE_SSO=true
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id
VITE_GITHUB_CLIENT_ID=your_github_client_id

# MFA Configuration
VITE_ENABLE_MFA=true
MFA_ISSUER=MIA Warehouse Management
MFA_APP_NAME=MIA WMS

# ======================
# API & CORS
# ======================
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ======================
# WEBSOCKET & REALTIME
# ======================
VITE_WEBSOCKET_URL=ws://localhost:3001
VITE_SOCKET_IO_URL=http://localhost:3001
WEBSOCKET_PORT=3001
ENABLE_WEBSOCKET=true
ENABLE_SOCKET_IO=true

# ======================
# AI SERVICE (Python)
# ======================
VITE_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
ENABLE_AI_SERVICE=true

# ======================
# LOGGING & MONITORING
# ======================
VITE_LOG_LEVEL=info
VITE_LOG_TO_CONSOLE=true
VITE_LOG_TO_GOOGLE_SHEETS=false
VITE_PERFORMANCE_MONITORING=true
VITE_ANALYTICS_ENABLED=false
VITE_ERROR_REPORTING=true

# ======================
# TELEGRAM BOT (Alerts)
# ======================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ENABLE_TELEGRAM_ALERTS=false

# ======================
# EMAIL SERVICE (SendGrid)
# ======================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@mia.vn
SENDGRID_FROM_NAME=MIA Warehouse Management
ENABLE_EMAIL_ALERTS=false

# ======================
# DATABASE (Optional - if using DB)
# ======================
# DATABASE_URL=postgresql://user:password@localhost:5432/mia_warehouse
# REDIS_URL=redis://localhost:6379

# ======================
# BUILD CONFIGURATION
# ======================
GENERATE_SOURCEMAP=true
VITE_BUILD_DATE=auto
CI=false

# ======================
# DEPLOYMENT (Production)
# ======================
# Uncomment khi deploy production
# NODE_ENV=production
# VITE_APP_ENV=production
# VITE_API_BASE_URL=https://api.mia.vn
# FRONTEND_URL=https://warehouse.mia.vn
# GENERATE_SOURCEMAP=false
